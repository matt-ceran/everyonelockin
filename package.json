{
  "name": "everyonelockin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1 --port 5187 --strictPort",
    "start:test": "node ./node_modules/@react-router/serve/bin.cjs ./build-test/server/index.js",
    "build": "react-router build",
    "start": "node --env-file=.env ./node_modules/@react-router/serve/bin.cjs ./build/server/index.js",
    "start:prod": "node server.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint app scripts/db.ts scripts/*.mjs tests/app server.js vite.config.ts react-router.config.ts drizzle.config.ts playwright.config.ts eslint.config.js",
    "test": "tsx --test tests/app/*.test.ts",
    "test:e2e": "node --env-file=.env scripts/test-e2e.mjs",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build",
    "format": "prettier --write app 'scripts/*.{ts,mjs}' tests/app '*.{ts,js,json}' '.github/**/*.yml' .prettierrc.json",
    "format:check": "prettier --check app 'scripts/*.{ts,mjs}' tests/app '*.{ts,js,json}' '.github/**/*.yml' .prettierrc.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env scripts/db.ts migrate",
    "db:migrate:prod": "node ./node_modules/tsx/dist/cli.mjs scripts/db.ts migrate",
    "db:seed": "tsx --env-file=.env scripts/db.ts seed",
    "db:up": "node scripts/db-start.mjs"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "3.1.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@react-router/express": "8.3.1",
    "@react-router/node": "8.3.1",
    "@react-router/serve": "8.3.1",
    "compression": "1.8.2",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "isbot": "^5.1.0",
    "morgan": "1.12.1",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.3.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "tsx": "4.23.13",
    "typescript": "~6.0.0",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
